# Copy this file to .env.local and fill in values before deploying.
# NEVER commit .env.local to version control.

# ─── App ──────────────────────────────────────────────────────────────────────
# Public app URL (used for CORS, redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Authentication (when a real auth layer is added) ─────────────────────────
# AUTH_SECRET=              # openssl rand -base64 32
# AUTH_PROVIDER_CLIENT_ID=
# AUTH_PROVIDER_CLIENT_SECRET=

# ─── Database (when persistence is added) ─────────────────────────────────────
# DATABASE_URL=             # e.g. postgresql://user:pass@host:5432/db  — use a vault/secret manager in prod

# ─── Email / Notifications ────────────────────────────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=               # store in IBM Key Protect or HashiCorp Vault — never hardcode
